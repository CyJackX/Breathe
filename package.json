{
  "name": "breathe-widget",
  "version": "0.1.0",
  "description": "Lightweight breathing reminder widget.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
