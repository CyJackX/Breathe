{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BreatheWidget",
  "version": "0.1.0",
  "identifier": "com.breathe.widget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BreatheWidget",
        "url": "index.html",
        "width": 240,
        "height": 240,
        "resizable": true,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "BreatheWidget Settings",
        "url": "settings.html",
        "width": 520,
        "height": 520,
        "resizable": true,
        "alwaysOnTop": false,
        "transparent": false,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
